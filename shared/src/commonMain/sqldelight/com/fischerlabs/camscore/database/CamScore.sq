CREATE TABLE test_results (
    test_id TEXT NOT NULL PRIMARY KEY,
    device_model TEXT NOT NULL,
    os_version TEXT NOT NULL,
    platform TEXT NOT NULL,
    has_ois INTEGER NOT NULL DEFAULT 0,
    has_ultrawide INTEGER NOT NULL DEFAULT 0,
    has_telephoto INTEGER NOT NULL DEFAULT 0,
    sensor_megapixels REAL NOT NULL DEFAULT 0.0,
    lens_count INTEGER NOT NULL DEFAULT 1,
    timestamp_epoch_ms INTEGER NOT NULL,
    af_lock_time_ms INTEGER NOT NULL,
    af_peak_sharpness REAL NOT NULL,
    af_sharpness_variance REAL NOT NULL,
    af_health_percent REAL NOT NULL,
    af_uncapped_score INTEGER NOT NULL,
    ois_dampening_ratio REAL NOT NULL,
    ois_pixel_shake REAL NOT NULL,
    ois_gyro_shake REAL NOT NULL,
    ois_health_percent REAL NOT NULL,
    ois_uncapped_score INTEGER NOT NULL,
    ois_is_non_ois_device INTEGER NOT NULL DEFAULT 0,
    lens_color_shift_delta_e REAL NOT NULL,
    lens_switch_lag_ms INTEGER NOT NULL,
    lens_health_percent REAL NOT NULL,
    lens_uncapped_score INTEGER NOT NULL,
    overall_health_percent REAL NOT NULL,
    cam_score INTEGER NOT NULL,
    health_rating TEXT NOT NULL,
    month_key TEXT NOT NULL,
    verification_hash TEXT NOT NULL
);

-- Insert a new test result
insertTestResult:
INSERT INTO test_results (
    test_id, device_model, os_version, platform, has_ois, has_ultrawide, has_telephoto,
    sensor_megapixels, lens_count, timestamp_epoch_ms,
    af_lock_time_ms, af_peak_sharpness, af_sharpness_variance, af_health_percent, af_uncapped_score,
    ois_dampening_ratio, ois_pixel_shake, ois_gyro_shake, ois_health_percent, ois_uncapped_score, ois_is_non_ois_device,
    lens_color_shift_delta_e, lens_switch_lag_ms, lens_health_percent, lens_uncapped_score,
    overall_health_percent, cam_score, health_rating, month_key, verification_hash
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get all test results ordered by most recent first
getAllResults:
SELECT * FROM test_results ORDER BY timestamp_epoch_ms DESC;

-- Get a single result by test ID
getResultById:
SELECT * FROM test_results WHERE test_id = ?;

-- Get results for a specific device model
getResultsByDevice:
SELECT * FROM test_results WHERE device_model = ? ORDER BY timestamp_epoch_ms DESC;

-- Get health trend data (health percent over time)
getHealthTrend:
SELECT test_id, timestamp_epoch_ms, overall_health_percent, cam_score
FROM test_results ORDER BY timestamp_epoch_ms ASC;

-- Get results by month key
getResultsByMonth:
SELECT * FROM test_results WHERE month_key = ? ORDER BY cam_score DESC;

-- Delete a single result
deleteResult:
DELETE FROM test_results WHERE test_id = ?;

-- Clear all history
clearAllHistory:
DELETE FROM test_results;

-- Count total results
countResults:
SELECT COUNT(*) FROM test_results;
