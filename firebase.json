{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/verify/**",
        "destination": "/verify.html"
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
